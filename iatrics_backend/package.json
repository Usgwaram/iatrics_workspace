{
  "name": "iatrics-backend",
  "version": "1.0.0",
  "description": "Backend API for Iatrics Platform",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "admin:create": "node scripts/createAdmin.js",
    "seed": "node src/seeders/adminSeeder.js",
    "db:repair-consultations": "node scripts/repairConsultationSchema.js",
    "db:repair-providers": "node scripts/repairProviderSchema.js",
    "test": "jest --runInBand",
    "load:consultations": "k6 run load-tests/consultations.k6.js",
    "stress:consultations": "K6_SCENARIO=stress k6 run load-tests/consultations.k6.js"
  },
  "dependencies": {
    "agora-access-token": "^2.0.4",
    "agora-token": "^2.0.5",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "bullmq": "^5.76.5",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.1",
    "newman-reporter-html": "^1.0.5",
    "node-cron": "^4.2.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.2.2"
